# Template environment backend Kaswise
# Cara pakai:
# 1) cp backend/.env.example backend/.env
# 2) Isi semua placeholder sesuai environment lokal / sandbox Anda
# 3) Jangan commit file backend/.env yang berisi secret asli

# Provider pembayaran utama.
# Default aman: tetap pakai Midtrans sampai integrasi Mayar benar-benar siap.
PAYMENT_PRIMARY_PROVIDER=midtrans

# =========================
# Midtrans (fallback)
# =========================
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false

# =========================
# Mayar (sandbox / staging)
# =========================
# Isi dengan API key sandbox / test dari dashboard Mayar.
MAYAR_API_KEY=your-mayar-sandbox-api-key

# Gunakan default backend saat ini. Jika Mayar memberi endpoint lain untuk sandbox,
# ganti nilai ini sesuai dokumentasi / dashboard akun Anda.
MAYAR_BASE_URL=https://api.mayar.id/hl/v1

# URL return/redirect Mayar untuk membawa user kembali ke PWA/app Kaswise.
# Gunakan route publik aplikasi (contoh halaman upgrade), bukan endpoint API backend.
MAYAR_REDIRECT_URL=https://kaswise.com/upgrade

# Fallback legacy bila environment lama masih memakainya. Jangan isi dua-duanya berbeda.
# MAYAR_CALLBACK_URL=https://kaswise.com/upgrade

# Guard limited-production testing: hanya email akun Supabase di allowlist ini
# yang boleh masuk flow checkout Mayar. Kosong = aman, tidak ada user yang bisa pakai Mayar.
# Isi sebagai daftar email dipisah koma. Pencocokan tidak case-sensitive.
MAYAR_ALLOWED_EMAILS=

# Default nonaktif agar aman sampai webhook dan aktivasi profile siap dipakai.
MAYAR_WEBHOOKS_ENABLED=false
MAYAR_ACTIVATION_ENABLED=false

# Soft-auth webhook Mayar (Mayar TIDAK menandatangani webhook — lihat ADR-0003).
# Isi merchantId akun Mayar Anda dari dashboard agar endpoint /webhooks/mayar
# menolak payload dari merchant lain sebelum re-fetch API. Kosongkan untuk
# mengandalkan model re-fetch-from-API saja.
MAYAR_MERCHANT_ID=
