{
  "name": "kaswise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm dev:mobile",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:mobile:web": "pnpm --filter mobile web",
    "backend:dev": "cd backend && venv\\Scripts\\uvicorn main:app --reload --port 8000",
    "test": "pnpm -r test && pnpm test:backend",
    "test:web": "pnpm --filter web test",
    "test:mobile": "pnpm --filter mobile test",
    "test:backend": "cd backend && venv\\Scripts\\python.exe -m pytest",
    "build": "corepack pnpm --filter web build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "test:golive:pwa": "corepack pnpm --filter mobile test:golive",
    "test:golive:pwa:headed": "corepack pnpm --filter mobile test:golive:headed",
    "build:mobile-pwa": "corepack pnpm --filter mobile export:pwa",
    "deploy:mobile-pwa": "corepack pnpm --filter mobile deploy:pwa"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.16.0",
      "tar": "^7.5.11",
      "@xmldom/xmldom": "^0.8.13",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "fast-xml-parser": "^5.7.0",
      "send": "^0.19.0",
      "postcss": "^8.5.14"
    }
  }
}
