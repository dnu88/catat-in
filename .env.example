# ============================================================
# CATAT.IN - Environment Variables Template (Firebase-first)
# Salin nilai yang relevan ke:
# - backend/.env untuk backend FastAPI
# - apps/web/.env.local untuk frontend local
# - dashboard hosting (Vercel + provider backend opsional) untuk production
# Jangan commit secret production ke repository.
# ============================================================

# ============================================================
# FRONTEND (Vite) - REQUIRED
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: isi hanya jika backend publik dipakai untuk AI OCR/import/groups.
# Contoh: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=

# ============================================================
# BACKEND (FastAPI) - REQUIRED jika backend dipakai
# ============================================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase Admin credentials (required untuk backend auth + Firestore)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Gunakan format satu baris dengan \n escape, bukan multiline mentah.
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Comma-separated atau JSON array.
# Rekomendasi production (frontend di Vercel):
# - domain utama Vercel project
# - domain custom (jika ada)
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://app.yourdomain.com
# Host backend API yang valid (tanpa protocol)
ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1

STORAGE_BUCKET_RECEIPTS=receipts
STORAGE_BUCKET_AVATARS=avatars
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AI_ENDPOINT=20

# Optional AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# LEGACY / OPTIONAL VARIABLES
# Boleh dikosongkan jika tidak dipakai.
# ============================================================

# Supabase legacy compatibility
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=

# Midtrans optional integration
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ============================================================
# KASWISE v1.0 — Mobile-First Stack (Expo + Supabase Cloud)
# ============================================================

# Supabase Cloud (REQUIRED untuk mobile-first stack)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# AI Providers (server-side only; never expose provider keys via EXPO_PUBLIC_*)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Edge Functions environment (set with `supabase secrets set`, do not bundle into the mobile app)
SUPABASE_EDGE_FUNCTIONS_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
SUPABASE_EDGE_FUNCTIONS_OPENAI_API_KEY=${OPENAI_API_KEY}

# Mobile App Configuration
EXPO_PUBLIC_APP_NAME=Kaswise
EXPO_PUBLIC_APP_SCHEME=kaswise
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development Flags
EXPO_PUBLIC_ENABLE_LOGGING=true
EXPO_PUBLIC_ENABLE_ANALYTICS=false
