# ============================================================
# CATAT.IN - Environment Variables Template
# Salin nilai yang relevan ke:
# - backend/.env untuk backend FastAPI
# - apps/web/.env.local atau env dashboard hosting untuk frontend
# Jangan commit secret production ke repository.
# ============================================================

# ============================================================
# SHARED / SUPABASE
# Ambil dari Supabase Dashboard -> Project Settings -> API
# ============================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Optional local-only references
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=your-local-anon-key

# ============================================================
# BACKEND (FastAPI)
# Simpan ini di backend/.env saat local atau ke dashboard host backend
# ============================================================
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated atau JSON array.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://app.yourdomain.com
ALLOWED_HOSTS=your-backend.up.railway.app,api.yourdomain.com

STORAGE_BUCKET_RECEIPTS=receipts
STORAGE_BUCKET_AVATARS=avatars
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AI_ENDPOINT=20

# ============================================================
# ANTHROPIC / AI
# Optional jika fitur AI ingin aktif di production
# ============================================================
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# OPTIONAL INTEGRATIONS
# Boleh dikosongkan jika fitur payment / push notification belum dipakai
# ============================================================
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ============================================================
# FRONTEND (Vite)
# Simpan sebagai env di host frontend atau apps/web/.env.local
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: hanya jika fitur backend AI/import/group masih dipakai.
VITE_API_BASE_URL=
VITE_MIDTRANS_CLIENT_KEY=
