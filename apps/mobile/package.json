{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "export:pwa": "expo export --platform web --clear && node scripts/generate-spa-fallbacks.mjs",
    "check:bundle": "node scripts/check-bundle-markers.mjs",
    "sync:required-markers": "node scripts/generate-required-markers.mjs",
    "verify:live-registry": "node scripts/verify-live-feature-registry.mjs",
    "test:live-regression": "jest transaction-classifier receipt-intake receipt-item-categorizer transaction-new-edit-mode capture-envelope-suggestion capture-gating reports-screen tabs-index reports-ai-insight transactions-swipe-actions --runInBand",
    "quality:live": "pnpm verify:live-registry && pnpm type-check && pnpm test:live-regression && pnpm export:pwa && pnpm check:bundle",
    "verify:live-url": "node scripts/verify-live-url.mjs",
    "predeploy": "pnpm quality:live",
    "deploy:pwa": "node scripts/deploy-pwa.mjs",
    "report:release": "node scripts/generate-release-report.mjs",
    "report:marker-diff": "node scripts/marker-diff-report.mjs",
    "test:golive": "playwright test -c playwright.golive.config.ts",
    "test:golive:headed": "playwright test -c playwright.golive.config.ts --headed",
    "test:golive:debug": "playwright test -c playwright.golive.config.ts --debug --project=kaswise-live-mobile-chrome",
    "test:golive:install": "playwright install chromium"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/server": "^0.7.5",
    "@kaswise/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.16.0",
    "@supabase/supabase-js": "^2.105.3",
    "expo": "^54.0.34",
    "expo-av": "~16.0.8",
    "expo-constants": "^18.0.13",
    "expo-document-picker": "^57.0.1",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "^8.0.12",
    "expo-router": "^6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "^56.0.5",
    "metro-runtime": "^0.84.4",
    "nativewind": "^4.2.3",
    "phosphor-react-native": "^3.0.6",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.0",
    "@playwright/test": "^1.54.2",
    "@react-native/assets-registry": "0.81.5",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.11",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.17",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
