# Live PWA smoke-test target
KASWISE_GOLIVE_BASE_URL=https://kaswise.com

# Dedicated disposable account only. Email should include golive/smoke/e2e/qa/test.
KASWISE_GOLIVE_EMAIL=kaswise-golive-smoke@example.com
KASWISE_GOLIVE_PASSWORD=replace-with-a-strong-password

# Node-only Supabase admin credentials for setup/cleanup.
# Never expose this key in app runtime or commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional controls
# KASWISE_GOLIVE_SKIP_CLEANUP=false
# KASWISE_GOLIVE_ALLOW_UNSAFE_EMAIL=false
# KASWISE_GOLIVE_RUN_ID=manual-20260528
