{
  "expo": {
    "name": "Kaswise",
    "slug": "kaswise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "kaswise",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090B10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaswise.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090B10"
      },
      "package": "com.kaswise.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Kaswise",
      "shortName": "Kaswise",
      "description": "Aplikasi keuangan pribadi yang cerdas",
      "themeColor": "#090B10",
      "backgroundColor": "#090B10"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "supabaseUrl": "https://xqvtsgfakuehjwdmenuw.supabase.co",
      "supabaseAnonKey": "sb_publishable_5wHtNuoACq4r8OQRwf0wTQ_TJEJakPM"
    }
  }
}
